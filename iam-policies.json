{
  "description": "Reference IAM policies for the clinic booking platform (me-central-1, 3 AZs). Copy the 'policy' object of each entry into IAM. Replace <ACCOUNT_ID>, <KEY_ID>, <VERIFIED_DOMAIN>, and <YOUR_DOMAIN> before use.",
  "policies": {
    "ecs-task-role": {
      "description": "Attached to the ECS Fargate tasks (application code). Least privilege: send booking events to SQS, read and write patient files in S3 (SSE-KMS).",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "SendBookingEvents",
            "Effect": "Allow",
            "Action": ["sqs:SendMessage"],
            "Resource": "arn:aws:sqs:me-central-1:<ACCOUNT_ID>:booking-events"
          },
          {
            "Sid": "ReadWritePatientFiles",
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:PutObject"],
            "Resource": "arn:aws:s3:::clinic-booking-files-<ACCOUNT_ID>/patient-files/*"
          },
          {
            "Sid": "ListPatientFilesPrefix",
            "Effect": "Allow",
            "Action": ["s3:ListBucket"],
            "Resource": "arn:aws:s3:::clinic-booking-files-<ACCOUNT_ID>",
            "Condition": {
              "StringLike": { "s3:prefix": ["patient-files/*"] }
            }
          },
          {
            "Sid": "UseFilesKeyThroughS3Only",
            "Effect": "Allow",
            "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
            "Resource": "arn:aws:kms:me-central-1:<ACCOUNT_ID>:key/<KEY_ID>",
            "Condition": {
              "StringEquals": { "kms:ViaService": "s3.me-central-1.amazonaws.com" }
            }
          }
        ]
      }
    },

    "ecs-task-execution-role": {
      "description": "Used by ECS itself to start the task: pull the image from ECR, write logs to CloudWatch Logs, and inject the database secret. All three calls go through VPC endpoints.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "EcrAuthToken",
            "Effect": "Allow",
            "Action": ["ecr:GetAuthorizationToken"],
            "Resource": "*"
          },
          {
            "Sid": "PullAppImage",
            "Effect": "Allow",
            "Action": [
              "ecr:BatchCheckLayerAvailability",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchGetImage"
            ],
            "Resource": "arn:aws:ecr:me-central-1:<ACCOUNT_ID>:repository/clinic-booking-app"
          },
          {
            "Sid": "WriteContainerLogs",
            "Effect": "Allow",
            "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
            "Resource": "arn:aws:logs:me-central-1:<ACCOUNT_ID>:log-group:/ecs/clinic-booking:*"
          },
          {
            "Sid": "ReadDatabaseSecret",
            "Effect": "Allow",
            "Action": ["secretsmanager:GetSecretValue"],
            "Resource": "arn:aws:secretsmanager:me-central-1:<ACCOUNT_ID>:secret:clinic-booking/db-*"
          },
          {
            "Sid": "DecryptSecretKey",
            "Effect": "Allow",
            "Action": ["kms:Decrypt"],
            "Resource": "arn:aws:kms:me-central-1:<ACCOUNT_ID>:key/<KEY_ID>",
            "Condition": {
              "StringEquals": { "kms:ViaService": "secretsmanager.me-central-1.amazonaws.com" }
            }
          }
        ]
      }
    },

    "lambda-notification-role": {
      "description": "Execution role for the notification Lambda: consume booking events from SQS, send SMS through SNS and email through SES, write its own logs.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "ConsumeBookingEvents",
            "Effect": "Allow",
            "Action": [
              "sqs:ReceiveMessage",
              "sqs:DeleteMessage",
              "sqs:GetQueueAttributes"
            ],
            "Resource": "arn:aws:sqs:me-central-1:<ACCOUNT_ID>:booking-events"
          },
          {
            "Sid": "SendSms",
            "Effect": "Allow",
            "Action": ["sns:Publish"],
            "Resource": "*"
          },
          {
            "Sid": "SendEmail",
            "Effect": "Allow",
            "Action": ["ses:SendEmail", "ses:SendRawEmail"],
            "Resource": "arn:aws:ses:me-central-1:<ACCOUNT_ID>:identity/<VERIFIED_DOMAIN>",
            "Condition": {
              "StringEquals": { "ses:FromAddress": "noreply@<YOUR_DOMAIN>" }
            }
          },
          {
            "Sid": "WriteFunctionLogs",
            "Effect": "Allow",
            "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
            "Resource": "arn:aws:logs:me-central-1:<ACCOUNT_ID>:log-group:/aws/lambda/booking-notifier:*"
          }
        ]
      }
    },

    "s3-patient-files-bucket-policy": {
      "description": "Resource-based policy on the patient files bucket: reject any request that is not sent over TLS.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
              "arn:aws:s3:::clinic-booking-files-<ACCOUNT_ID>",
              "arn:aws:s3:::clinic-booking-files-<ACCOUNT_ID>/*"
            ],
            "Condition": {
              "Bool": { "aws:SecureTransport": "false" }
            }
          }
        ]
      }
    },

    "s3-gateway-endpoint-policy": {
      "description": "Policy on the S3 Gateway Endpoint: allow only the patient files prefix plus the ECR layer bucket (ECR image layers are served from S3, so the endpoint must allow it or image pulls fail).",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "AllowPatientFiles",
            "Effect": "Allow",
            "Principal": "*",
            "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
            "Resource": [
              "arn:aws:s3:::clinic-booking-files-<ACCOUNT_ID>",
              "arn:aws:s3:::clinic-booking-files-<ACCOUNT_ID>/patient-files/*"
            ]
          },
          {
            "Sid": "AllowEcrImageLayers",
            "Effect": "Allow",
            "Principal": "*",
            "Action": ["s3:GetObject"],
            "Resource": "arn:aws:s3:::prod-me-central-1-starport-layer-bucket/*"
          }
        ]
      }
    }
  }
}
